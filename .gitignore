# OpenCode local state
.opencode/
opencode.log

# === Sharing policy =========================================================
# Study MATERIAL (course notes, transcripts, book excerpts, question banks) is
# committed so the team can study from it. Only PERSONAL-USE files — your exam
# results, progress log, and study plans — stay local and are never committed.
# Content lives under exams/<exam>/material and exams/<exam>/assets.
# ===========================================================================

# Large media / archives are kept local (bloat, not needed to study from repo)
exams/**/*.mp4
exams/**/*.zip

# --- PERSONAL-USE files: never commit ---

# Private by default: progress, mock state, evidence, backups, and dated plans.
# Keep directories traversable so only these shared README templates are allowed.
/exams/*/assets/**
!/exams/*/assets/**/
!/exams/*/assets/README.md
!/exams/*/assets/study-plans/README.md

# Cross-exam personal state follows the same rule, regardless of file extension.
/assets/**
!/assets/**/
!/assets/README.md

# Your real Microsoft certification score reports (private)
exams/*/material/test-exams/**/certification/**

# Graded practice-exam runs that record your own answers/scores (private)
exams/*/material/test-exams/**/results.md
exams/*/material/test-exams/**/score-report.*

# Agent-side helper scripts (one-off parsers, formatters) — not study material
scripts/
!.github/skills/coverage-audit/scripts/
!.github/skills/coverage-audit/scripts/coverage.py
!.github/skills/coverage-audit/scripts/session.py

# Generated Python bytecode for the local coverage checker
.github/skills/coverage-audit/**/__pycache__/

# Secrets
.env
.env.local
*.key

# OS
Thumbs.db
.DS_Store
/.vscode
/exams/az-305/material/test-exams/measureup/imgs
