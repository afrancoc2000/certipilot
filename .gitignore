# OpenCode local state
.opencode/
opencode.log

# --- Multi-exam study content lives under exams/<exam>/material and
# --- exams/<exam>/assets. Patterns below apply across all exams.

# External study dataset (Valentina's OneDrive material, etc.)
# exams/*/material/savill/
exams/**/*.mp4
exams/**/*.zip
exams/**/*.pdf

# Do not ignore the cheat sheets PDFs, as they are useful reference material
!exams/*/material/cheat-sheets/**/*.pdf

# Extracted O'Reilly book content (personal-use only, do not commit)
# exams/*/material/oreilly/**/*.md
# exams/*/material/oreilly/**/*.txt
!exams/*/material/oreilly/README.md

# Pluralsight course transcripts (personal-use only, do not commit)
# exams/*/material/pluralsight/**/*.txt
# exams/*/material/pluralsight/**/*.md
!exams/*/material/pluralsight/README.md

# Graded test-exam runs with personal answers (personal-use only, do not commit)
# exams/*/material/test-exams/**/*.md
!exams/*/material/test-exams/README.md

# Personal study progress / agent memory (per exam)
exams/*/assets/progress.md

# Private study plans (local only, per exam) — keep the README tracked
exams/*/assets/study-plans/**/*.md
!exams/*/assets/study-plans/README.md

# Shared cross-exam study assets (master/mixed plan, local only)
assets/**/*.md
!assets/README.md

# Agent-side helper scripts (one-off parsers, formatters) — not study material
scripts/

# Secrets
.env
.env.local
*.key

# OS
Thumbs.db
.DS_Store
/.vscode
/exams/*/material/test-exams/microsoft/certification/**/*.md
